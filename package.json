{
  "name": "feishu-plugin",
  "version": "0.10.0",
  "private": true,
  "description": "飞书接入 DSH 侧栏：收发群消息、浏览云空间文件夹、读写飞书文档（双身份 + 大纲 + 字体字号 + 移动）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "feishu",
    "lark",
    "docx",
    "im"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonlight328/dsh-feishu-plugin.git"
  },
  "homepage": "https://github.com/moonlight328/dsh-feishu-plugin#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test:client": "node scripts/test-client.mjs",
    "test:bridge": "node scripts/test-bridge.mjs",
    "test:upload": "node scripts/test-upload.mjs",
    "test:p0": "node scripts/test-p0.mjs",
    "test:msg": "node scripts/test-msg.mjs",
    "check:creds": "node scripts/check-creds.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
